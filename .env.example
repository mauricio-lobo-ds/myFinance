TELEGRAM_TOKEN_BOTFATHER=seu_token_aqui

AUTHORIZED_USER_IDS=123456789,987654321
# Como descobrir seu ID do Telegram:
# 1. Pesquise por @userinfobot no Telegram
# 2. Clique em Start
# 3. Ele responde na hora com seu User ID (ex: 123456789)
# Para autorizar mais pessoas, peça que façam o mesmo e te mandem o ID.

# Nomes amigáveis para cada usuário (opcional, mas recomendado)
# Formato: ID:Nome separados por vírgula
USER_NAMES=123456789:Mauricio,987654321:Ana

LLM_API_KEY=xxxxxxxxxxxxx
#OpenRouter

GOOGLE_SHEET_NAME=MensagensBot

# Credenciais do Google Service Account (conteúdo completo do arquivo JSON numa única linha)
# Para uso local: deixe vazio e mantenha o arquivo em google/don-meu-agente-6886231ffdfe.json
# Para deploy (Railway, etc): cole aqui o conteúdo do JSON numa única linha
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"seu-projeto","private_key_id":"abc123","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"sua-conta@seu-projeto.iam.gserviceaccount.com","client_id":"000000000000000000000","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/sua-conta%40seu-projeto.iam.gserviceaccount.com"}
